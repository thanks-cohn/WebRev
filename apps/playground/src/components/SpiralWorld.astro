<section class="world-shell" data-webrev-id="world.spiral-bounce">
  <div class="world-copy">
    <div class="eyebrow">THE WORLD IN 3D</div>
    <h2>Keep the bounce alive.</h2>
    <p>Steer an always-bouncing ball across an endless spiral staircase. Climb, fall, recover, grab it, and throw it.</p>

    <div class="controls">
      <div><kbd>↑ ↓ ← →</kbd><span>steer in 3D</span></div>
      <div><kbd>Mouse</kbd> / <kbd>Touch</kbd><span>grab and toss</span></div>
      <div><kbd>R</kbd><span>reset</span></div>
    </div>
  </div>

  <div class="viewport">
    <canvas id="spiral-world-canvas" width="960" height="640"></canvas>
    <div class="hud">
      <span id="height-label">height 0</span>
      <span>endless staircase</span>
    </div>
  </div>
</section>

<script>
  const canvas = document.getElementById("spiral-world-canvas");
  const heightLabel = document.getElementById("height-label");

  if (canvas instanceof HTMLCanvasElement) {
    const gameCanvas: HTMLCanvasElement = canvas;
    const ctx = gameCanvas.getContext("2d");

    if (ctx) {
      type Vec3 = { x: number; y: number; z: number };
      type Projected = { x: number; y: number; depth: number; scale: number };

      const keys = new Set<string>();
      const stepRise = 0.72;
      const stepAngle = 0.46;
      const spiralRadius = 4.4;
      const stepLength = 2.6;
      const stepWidth = 1.2;
      const ballRadius = 0.42;

      const gravity = -14;
      const bounceSpeed = 7.1;
      const steerAcceleration = 7.5;
      const drag = 0.985;

      let ball: Vec3 = { x: spiralRadius, y: 1.4, z: 0 };
      let velocity: Vec3 = { x: 0, y: 0, z: 1.2 };
      let cameraY = 0;
      let impact = 0;
      let dragging = false;
      let pointerLastX = 0;
      let pointerLastY = 0;
      let pointerLastTime = performance.now();
      let throwVx = 0;
      let throwVy = 0;
      let previous = performance.now();

      function clamp(value: number, min: number, max: number) {
        return Math.max(min, Math.min(max, value));
      }

      function reset() {
        ball = { x: spiralRadius, y: 1.5, z: 0 };
        velocity = { x: 0, y: 0, z: 1.1 };
        cameraY = 0;
        impact = 0;
        dragging = false;
      }

      function resizeForDpr() {
        const rect = gameCanvas.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const width = Math.max(1, Math.floor(rect.width * dpr));
        const height = Math.max(1, Math.floor(rect.height * dpr));

        if (gameCanvas.width !== width || gameCanvas.height !== height) {
          gameCanvas.width = width;
          gameCanvas.height = height;
        }

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        return { width: rect.width, height: rect.height };
      }

      function stepCenter(index: number): Vec3 {
        const angle = index * stepAngle;
        return {
          x: Math.cos(angle) * spiralRadius,
          y: index * stepRise,
          z: Math.sin(angle) * spiralRadius
        };
      }

      function rotatePoint(x: number, z: number, angle: number) {
        const c = Math.cos(angle);
        const s = Math.sin(angle);
        return {
          x: x * c - z * s,
          z: x * s + z * c
        };
      }

      function project(point: Vec3, width: number, height: number): Projected | null {
        const camera = { x: 0, y: cameraY + 2.6, z: 13.5 };
        const dx = point.x - camera.x;
        const dy = point.y - camera.y;
        const dz = point.z - camera.z;

        const yaw = 0;
        const yawed = rotatePoint(dx, dz, yaw);
        const pitch = -0.12;

        const cp = Math.cos(pitch);
        const sp = Math.sin(pitch);
        const ry = dy * cp - yawed.z * sp;
        const rz = dy * sp + yawed.z * cp;

        const depth = -rz;
        if (depth <= 0.5) return null;

        const focal = Math.min(width, height) * 1.05;
        const scale = focal / depth;

        return {
          x: width / 2 + yawed.x * scale,
          y: height * 0.46 - ry * scale,
          depth,
          scale
        };
      }

      function stepCorners(index: number): Vec3[] {
        const center = stepCenter(index);
        const angle = index * stepAngle;
        const tangent = angle + Math.PI / 2;

        const tx = Math.cos(tangent);
        const tz = Math.sin(tangent);
        const rx = Math.cos(angle);
        const rz = Math.sin(angle);

        const hl = stepLength / 2;
        const hw = stepWidth / 2;

        return [
          { x: center.x + tx * hl + rx * hw, y: center.y, z: center.z + tz * hl + rz * hw },
          { x: center.x - tx * hl + rx * hw, y: center.y, z: center.z - tz * hl + rz * hw },
          { x: center.x - tx * hl - rx * hw, y: center.y, z: center.z - tz * hl - rz * hw },
          { x: center.x + tx * hl - rx * hw, y: center.y, z: center.z + tz * hl - rz * hw }
        ];
      }

      function ballScreen(width: number, height: number) {
        return project(ball, width, height);
      }

      function pointerPosition(event: PointerEvent) {
        const rect = gameCanvas.getBoundingClientRect();
        return { x: event.clientX - rect.left, y: event.clientY - rect.top };
      }

      gameCanvas.addEventListener("pointerdown", (event) => {
        const rect = gameCanvas.getBoundingClientRect();
        const projected = ballScreen(rect.width, rect.height);
        if (!projected) return;

        const p = pointerPosition(event);
        const radius = Math.max(18, ballRadius * projected.scale);

        if (Math.hypot(p.x - projected.x, p.y - projected.y) <= radius * 1.25) {
          dragging = true;
          gameCanvas.setPointerCapture(event.pointerId);
          pointerLastX = p.x;
          pointerLastY = p.y;
          pointerLastTime = performance.now();
          throwVx = 0;
          throwVy = 0;
          velocity = { x: 0, y: 0, z: 0 };
        }
      });

      gameCanvas.addEventListener("pointermove", (event) => {
        if (!dragging) return;

        const p = pointerPosition(event);
        const now = performance.now();
        const dt = Math.max((now - pointerLastTime) / 1000, 0.001);
        const dx = p.x - pointerLastX;
        const dy = p.y - pointerLastY;

        throwVx = clamp(dx / dt, -1800, 1800);
        throwVy = clamp(dy / dt, -1800, 1800);

        ball.x += dx * 0.012;
        ball.y -= dy * 0.012;

        pointerLastX = p.x;
        pointerLastY = p.y;
        pointerLastTime = now;
      });

      function releasePointer(event: PointerEvent) {
        if (!dragging) return;
        dragging = false;

        velocity.x = throwVx * 0.006;
        velocity.y = -throwVy * 0.008;
        velocity.z += throwVx * 0.0025;

        if (gameCanvas.hasPointerCapture(event.pointerId)) {
          gameCanvas.releasePointerCapture(event.pointerId);
        }
      }

      gameCanvas.addEventListener("pointerup", releasePointer);
      gameCanvas.addEventListener("pointercancel", releasePointer);

      window.addEventListener("keydown", (event) => {
        const key = event.key.toLowerCase();

        if (["arrowup", "arrowdown", "arrowleft", "arrowright"].includes(key)) {
          event.preventDefault();
          keys.add(key);
        }

        if (key === "r") reset();
      });

      window.addEventListener("keyup", (event) => {
        keys.delete(event.key.toLowerCase());
      });

      function collideWithSteps(previousY: number) {
        if (velocity.y > 0) return;

        const approx = Math.round(ball.y / stepRise);
        let bestIndex: number | null = null;
        let bestDistance = Infinity;

        for (let i = approx - 3; i <= approx + 3; i++) {
          const center = stepCenter(i);
          const landingY = center.y + ballRadius;

          if (!(previousY >= landingY && ball.y <= landingY)) continue;

          const dx = ball.x - center.x;
          const dz = ball.z - center.z;
          const distance = Math.hypot(dx, dz);

          if (distance < 1.35 && distance < bestDistance) {
            bestDistance = distance;
            bestIndex = i;
          }
        }

        if (bestIndex !== null) {
          const center = stepCenter(bestIndex);
          ball.y = center.y + ballRadius;
          velocity.y = bounceSpeed + Math.min(Math.abs(velocity.y) * 0.18, 2.4);
          impact = clamp(Math.abs(velocity.y) / 10, 0.25, 1);
        }
      }

      function update(dt: number) {
        if (!dragging) {
          let ax = 0;
          let az = 0;

          if (keys.has("arrowleft")) ax -= steerAcceleration;
          if (keys.has("arrowright")) ax += steerAcceleration;
          if (keys.has("arrowup")) az -= steerAcceleration;
          if (keys.has("arrowdown")) az += steerAcceleration;

          velocity.x += ax * dt;
          velocity.z += az * dt;
          velocity.y += gravity * dt;

          velocity.x *= Math.pow(drag, dt * 60);
          velocity.z *= Math.pow(drag, dt * 60);

          const previousY = ball.y;
          ball.x += velocity.x * dt;
          ball.y += velocity.y * dt;
          ball.z += velocity.z * dt;

          collideWithSteps(previousY);
        }

        cameraY += (ball.y - cameraY) * Math.min(1, dt * 3.2);
        impact *= Math.pow(0.035, dt);
      }

      function draw(now: number) {
        const dt = Math.min((now - previous) / 1000, 1 / 30);
        previous = now;
        update(dt);

        const { width, height } = resizeForDpr();

        ctx.clearRect(0, 0, width, height);

        const bg = ctx.createLinearGradient(0, 0, 0, height);
        bg.addColorStop(0, "#101827");
        bg.addColorStop(0.48, "#070a10");
        bg.addColorStop(1, "#030405");
        ctx.fillStyle = bg;
        ctx.fillRect(0, 0, width, height);

        const glow = ctx.createRadialGradient(width / 2, height * 0.34, 20, width / 2, height * 0.45, Math.max(width, height) * 0.7);
        glow.addColorStop(0, "rgba(76,112,190,.16)");
        glow.addColorStop(1, "rgba(0,0,0,0)");
        ctx.fillStyle = glow;
        ctx.fillRect(0, 0, width, height);

        const centerIndex = Math.round(cameraY / stepRise);
        const drawItems: Array<{ depth: number; corners: Projected[]; index: number }> = [];

        for (let i = centerIndex - 34; i <= centerIndex + 34; i++) {
          const projectedCorners = stepCorners(i)
            .map((corner) => project(corner, width, height))
            .filter((value): value is Projected => value !== null);

          if (projectedCorners.length !== 4) continue;

          const depth = projectedCorners.reduce((sum, p) => sum + p.depth, 0) / 4;
          drawItems.push({ depth, corners: projectedCorners, index: i });
        }

        drawItems.sort((a, b) => b.depth - a.depth);

        for (const item of drawItems) {
          const alpha = clamp(1 - item.depth / 38, 0.12, 0.78);
          const hueShift = ((item.index % 14) + 14) % 14;

          ctx.beginPath();
          ctx.moveTo(item.corners[0].x, item.corners[0].y);
          for (let c = 1; c < item.corners.length; c++) {
            ctx.lineTo(item.corners[c].x, item.corners[c].y);
          }
          ctx.closePath();

          ctx.fillStyle = `rgba(${62 + hueShift * 2}, ${88 + hueShift * 3}, ${145 + hueShift * 4}, ${alpha})`;
          ctx.fill();
          ctx.strokeStyle = `rgba(220,235,255,${alpha * 0.34})`;
          ctx.lineWidth = 1;
          ctx.stroke();
        }

        const projectedBall = ballScreen(width, height);
        if (projectedBall) {
          const speed = Math.hypot(velocity.x, velocity.y, velocity.z);
          const stretch = clamp(speed / 13, 0, 0.35);
          const squash = impact * 0.34;
          const scaleX = 1 + squash - stretch * 0.12;
          const scaleY = 1 - squash + stretch * 0.32;
          const radius = clamp(ballRadius * projectedBall.scale, 10, 84);

          ctx.save();
          ctx.translate(projectedBall.x, projectedBall.y);
          ctx.scale(scaleX, scaleY);

          const ballGlow = ctx.createRadialGradient(-radius * 0.28, -radius * 0.32, radius * 0.12, 0, 0, radius);
          ballGlow.addColorStop(0, "#ffffff");
          ballGlow.addColorStop(0.18, "#e5f0ff");
          ballGlow.addColorStop(0.48, "#73a7ff");
          ballGlow.addColorStop(1, "#17294e");

          ctx.fillStyle = ballGlow;
          ctx.beginPath();
          ctx.arc(0, 0, radius, 0, Math.PI * 2);
          ctx.fill();

          ctx.strokeStyle = dragging ? "rgba(255,255,255,.85)" : "rgba(255,255,255,.28)";
          ctx.lineWidth = dragging ? 2 : 1;
          ctx.stroke();
          ctx.restore();
        }

        if (heightLabel) {
          heightLabel.textContent = `height ${Math.round(ball.y * 10) / 10}`;
        }

        requestAnimationFrame(draw);
      }

      reset();
      requestAnimationFrame(draw);
    }
  }
</script>

<style>
  .world-shell {
    display:grid;
    grid-template-columns:minmax(220px,.62fr) minmax(0,1.8fr);
    gap:28px;
    align-items:stretch;
  }
  .world-copy,.viewport {
    border:1px solid rgba(255,255,255,.1);
    border-radius:28px;
    background:rgba(255,255,255,.035);
    backdrop-filter:blur(16px);
  }
  .world-copy { padding:26px; }
  .eyebrow { font-size:.72rem; letter-spacing:.2em; opacity:.58; }
  h2 { font-size:clamp(2rem,4vw,3.6rem); margin:.35em 0 .25em; letter-spacing:-.045em; }
  p { color:#b8bdc7; line-height:1.65; }
  .controls { display:grid; gap:10px; margin-top:24px; }
  .controls div { display:grid; grid-template-columns:minmax(110px,auto) 1fr; gap:10px; align-items:center; color:#aeb6c5; font-size:.82rem; }
  kbd { border:1px solid rgba(255,255,255,.15); border-bottom-color:rgba(255,255,255,.3); background:rgba(255,255,255,.06); border-radius:7px; padding:3px 6px; font:inherit; color:#f5f7fb; }
  .viewport { position:relative; min-height:560px; overflow:hidden; touch-action:none; cursor:grab; }
  .viewport:active { cursor:grabbing; }
  canvas { display:block; width:100%; height:100%; min-height:560px; }
  .hud { position:absolute; left:18px; right:18px; bottom:16px; display:flex; justify-content:space-between; gap:12px; color:#aeb6c5; font-size:.76rem; pointer-events:none; }
  @media (max-width:800px) {
    .world-shell { grid-template-columns:1fr; }
    .viewport,canvas { min-height:460px; }
  }
</style>
