---
import { resolveLink } from "@webrev/core";
import linksConfig from "../../../../../config/links.json";
import presentationConfig from "../../../../../config/presentations/uniqueness-rewarded.json";
import SpatialPresentation from "../../components/SpatialPresentation.astro";

const homeHref = resolveLink(linksConfig, "home", import.meta.env.BASE_URL);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Design it Your Way · WebRev</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: Inter, ui-sans-serif, system-ui, sans-serif;
        background:#050608;
        color:#f7f7f4;
      }

      body {
        margin:0;
        min-height:100vh;
        background:
          radial-gradient(circle at 50% 0%, rgba(94,104,135,.16), transparent 34%),
          #050608;
      }

      main {
        width:min(1220px,calc(100% - 32px));
        margin:auto;
        padding:30px 0 90px;
      }

      nav {
        display:flex;
        justify-content:space-between;
        align-items:center;
        margin-bottom:46px;
      }

      nav a {
        color:#fff;
        text-decoration:none;
        opacity:.82;
      }

      .intro {
        margin-bottom:34px;
      }

      .eyebrow {
        letter-spacing:.2em;
        text-transform:uppercase;
        opacity:.58;
        font-size:.72rem;
      }

      h1 {
        font-size:clamp(3.4rem,9vw,7.8rem);
        line-height:.9;
        letter-spacing:-.065em;
        margin:.16em 0;
        max-width:1000px;
      }

      .lede {
        max-width:820px;
        color:#b8bdc7;
        line-height:1.7;
        font-size:1.05rem;
      }

      .note {
        margin-top:20px;
        color:#8f95a1;
        font-size:.88rem;
      }
    </style>
  </head>
  <body>
    <main>
      <nav>
        <a href={homeHref}>← WebRev</a>
        <span>Design it Your Way</span>
      </nav>

      <section class="intro">
        <div class="eyebrow">UNIQUENESS-REWARDED</div>
        <h1>Design it Your Way.</h1>
        <p class="lede">
          A spatial presentation format built to be rearranged. Swap the artwork, reshape the thread, move the objects, change the frame, rewrite the text, and decide how each scene reveals itself.
        </p>
        <p class="note">
          Use ← and → to move between arrangements. Some scenes reveal automatically; others wait for you to click the artwork.
        </p>
      </section>

      <SpatialPresentation config={presentationConfig} />
    </main>
  </body>
</html>
